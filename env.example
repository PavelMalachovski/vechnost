# Telegram Bot Configuration (from @BotFather). The settings read exactly
# this name; the old API_TOKEN_TELEGRAM is not read at all.
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Logging Configuration
LOG_LEVEL=INFO

# `production` on the production service, and nowhere else. With it the app
# refuses to start on a development default and lists what to set: a
# PostgreSQL DATABASE_URL with +asyncpg, an explicit ENABLE_PAYMENT, the
# Tribute key when payments are on, an https:// WEBAPP_URL. It also names the
# environment in Sentry.
ENVIRONMENT=development

# Error reporting (optional). Events carry the deployed commit as the release.
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>

# Payment Configuration
ENABLE_PAYMENT=FALSE
# Required whenever ENABLE_PAYMENT=TRUE. Tribute signs every webhook with
# HMAC-SHA256 over the body keyed by this API key and sends the digest in
# the `trbt-signature` header. Without a key the webhook is refused rather
# than trusted, because a webhook grants lifetime access.
TRIBUTE_API_KEY=your_tribute_api_key_here
TRIBUTE_BASE_URL=https://api.tribute.to
TRIBUTE_PAYMENT_URL=https://tribute.to/your_page_here
# The Tribute product id of the access itself. The Mini App's buy button,
# the price it shows and the bot's purchase button use exactly this product.
# Unset, they take the cheapest synced product that is neither the gift
# (GIFT_PRODUCT_ID) nor the referral discount (REFERRAL_PAYMENT_URL); set it
# once the catalogue holds more than one product.
# ACCESS_PRODUCT_ID=123456
# Optional second signing key, for a relay or a test harness in front of the
# endpoint. Accepted alongside the API key, never instead of it.
# WEBHOOK_SECRET=your_webhook_secret_here
# Bearer token for /admin/*. Falls back to TRIBUTE_API_KEY when unset, but
# set it: that key is an outbound credential and reusing it inbound means
# one leak costs both.
ADMIN_TOKEN=your_admin_token_here

# Who may run /broadcast in the bot: Telegram user ids, comma separated
# (/start then /id in @userinfobot gives you yours). Unset, the command is
# not registered at all, which is the right default for a bot that can
# message every user it has.
# ADMIN_IDS=111111111,222222222

# Referrals. The discount is a second Tribute product at 10% off, and this is
# its payment page: choosing which page a user sees is the whole of the
# discount, because Tribute owns the price. Leave it unset and referrals are
# still tracked while everyone pays the same.
# REFERRAL_PAYMENT_URL=https://tribute.to/your_discounted_product
# REFERRAL_DISCOUNT_PERCENT=10

# Mini App Configuration
# HTTPS URL where the webhook server hosts the Mini App (adds "Play in app" button)
# WEBAPP_URL=https://your-railway-app.up.railway.app/app/

# How an invite link is spelled. Pick whichever Mini App you set up in
# BotFather; both open the app on the right screen in one tap.
#
#   Bot Settings -> Configure Mini App  (a Main Mini App, no short name):
#     WEBAPP_MAIN_APP=true          -> t.me/<bot>?startapp=...
#   /newapp  (a named Mini App with a short name):
#     WEBAPP_SHORT_NAME=app         -> t.me/<bot>/app?startapp=...
#
# With neither, invites fall back to t.me/<bot>?start=... and the bot answers
# with a button into the app: two taps, and nothing to configure.
# WEBAPP_MAIN_APP=true
# WEBAPP_SHORT_NAME=app

# How many proxies sit in front of the app and append the address they saw
# to X-Forwarded-For. The rate limiter takes the client address that many
# entries from the end of the header. One on Railway; two with a CDN such as
# Cloudflare in front of it.
# TRUSTED_PROXY_HOPS=1

# Database Configuration
# For local development (SQLite):
# DATABASE_URL=sqlite+aiosqlite:///./vechnost.db

# For production (PostgreSQL on Railway):
DATABASE_URL=postgresql+asyncpg://postgres:password@postgres.railway.internal:5432/railway
