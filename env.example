# Telegram Bot Configuration
API_TOKEN_TELEGRAM=your_bot_token_here
# Alternative: TELEGRAM_BOT_TOKEN=your_bot_token_here

# Optional Configuration
CHAT_ID=your_chat_id_here

# Logging Configuration
LOG_LEVEL=INFO

# Payment Configuration
ENABLE_PAYMENT=FALSE
TRIBUTE_API_KEY=your_tribute_api_key_here
TRIBUTE_BASE_URL=https://api.tribute.to
TRIBUTE_PAYMENT_URL=https://tribute.to/your_page_here
# Required whenever ENABLE_PAYMENT=TRUE: without it the webhook is refused
# rather than trusted, because an unsigned webhook grants lifetime access.
WEBHOOK_SECRET=your_webhook_secret_here
# Bearer token for /admin/*. Falls back to TRIBUTE_API_KEY when unset, but
# set it: that key is an outbound credential and reusing it inbound means
# one leak costs both.
ADMIN_TOKEN=your_admin_token_here

# Who may run /broadcast in the bot: Telegram user ids, comma separated
# (/start then /id in @userinfobot gives you yours). Unset, the command is
# not registered at all, which is the right default for a bot that can
# message every user it has.
# ADMIN_IDS=111111111,222222222

# Referrals. The discount is a second Tribute product at 10% off, and this is
# its payment page: choosing which page a user sees is the whole of the
# discount, because Tribute owns the price. Leave it unset and referrals are
# still tracked while everyone pays the same.
# REFERRAL_PAYMENT_URL=https://tribute.to/your_discounted_product
# REFERRAL_DISCOUNT_PERCENT=10

# Mini App Configuration
# HTTPS URL where the webhook server hosts the Mini App (adds "Play in app" button)
# WEBAPP_URL=https://your-railway-app.up.railway.app/app/

# How an invite link is spelled. Pick whichever Mini App you set up in
# BotFather; both open the app on the right screen in one tap.
#
#   Bot Settings -> Configure Mini App  (a Main Mini App, no short name):
#     WEBAPP_MAIN_APP=true          -> t.me/<bot>?startapp=...
#   /newapp  (a named Mini App with a short name):
#     WEBAPP_SHORT_NAME=app         -> t.me/<bot>/app?startapp=...
#
# With neither, invites fall back to t.me/<bot>?start=... and the bot answers
# with a button into the app: two taps, and nothing to configure.
# WEBAPP_MAIN_APP=true
# WEBAPP_SHORT_NAME=app

# Database Configuration
# For local development (SQLite):
# DATABASE_URL=sqlite+aiosqlite:///./vechnost.db

# For production (PostgreSQL on Railway):
DATABASE_URL=postgresql+asyncpg://postgres:password@postgres.railway.internal:5432/railway
